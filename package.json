{
  "name": "las-gambusinas-launcher",
  "version": "1.2.0",
  "private": true,
  "author": "hgartemis3515",
  "description": "Panel nativo Windows: Backend, Cocina, Mozos (Expo), MongoDB, Git y datos data/",
  "repository": {
    "type": "git",
    "url": "https://github.com/hgartemis3515/las-gambusinas-launcher.git"
  },
  "bugs": {
    "url": "https://github.com/hgartemis3515/las-gambusinas-launcher/issues"
  },
  "homepage": "https://github.com/hgartemis3515/las-gambusinas-launcher#readme",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "predist": "node tools/kill-lockers-before-dist.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "lucide": "^1.8.0",
    "mongoose": "^8.1.3",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.lasgambusinas.launcher",
    "productName": "Las Gambusinas Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json",
      "package-lock.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerLanguages": [
        "es_ES",
        "en_US"
      ]
    }
  }
}
